generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Profile {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  email    String  @unique
  avatar   String?
  username String? @unique
  name     String?
  subtitle String?
  bio      String?
  language String  @default("en")
  isPrivate Boolean @default(false)
  isAdmin Boolean @default(false)
  isSystem Boolean @default(false)
  activityReadAt DateTime?

  posts         Post[]
  comments      Comment[]
  commentMentions CommentMention[]
  commentLikes  CommentLike[]
  postLikes     PostLike[]
  bookmarks     PostBookmark[]
  bookmarkCollections BookmarkCollection[]
  conversations ConversationParticipant[]
  sentMessages  Message[]                 @relation("SentMessages")
  stories       Story[]
  postTags      PostProfileTag[]
  profileLinks  ProfileLink[]

  followers    Follow[]      @relation("ProfileFollowers")
  following    Follow[]      @relation("ProfileFollowing")
  receivedFollowRequests FollowRequest[] @relation("FollowRequestsReceived")
  sentFollowRequests FollowRequest[] @relation("FollowRequestsSent")
  topicFollows TopicFollow[]
  blocksSent Block[] @relation("BlocksSent")
  blocksReceived Block[] @relation("BlocksReceived")
}

model Block {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  blockerId String @db.ObjectId
  blockedId String @db.ObjectId
  blocker Profile @relation("BlocksSent", fields: [blockerId], references: [id])
  blocked Profile @relation("BlocksReceived", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  directKey String   @unique
  name      String?
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  profileId String  @db.ObjectId
  profile   Profile @relation(fields: [profileId], references: [id])

  createdAt  DateTime  @default(now())
  lastReadAt DateTime?

  @@unique([conversationId, profileId])
  @@index([profileId])
}

model Message {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId String  @db.ObjectId
  sender   Profile @relation("SentMessages", fields: [senderId], references: [id])

  body      String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Follow {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  followerId String  @db.ObjectId
  follower   Profile @relation("ProfileFollowing", fields: [followerId], references: [id])

  followingId String  @db.ObjectId
  following   Profile @relation("ProfileFollowers", fields: [followingId], references: [id])

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
}

model Post {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  authorEmail String?
  author      Profile? @relation(fields: [authorEmail], references: [email])

  image       String
  images      String[] @default([])
  description String
  likesCount  Int      @default(0)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments  Comment[]
  likes     PostLike[]
  bookmarks PostBookmark[]
  bookmarkCollectionItems BookmarkCollectionPost[]
  topics    PostTopic[]
  profileTags PostProfileTag[]
}

model PostProfileTag {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  postId String @db.ObjectId
  post Post @relation(fields: [postId], references: [id])
  profileId String @db.ObjectId
  profile Profile @relation(fields: [profileId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, profileId])
  @@index([profileId])
}

model Story {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  authorEmail String
  author      Profile  @relation(fields: [authorEmail], references: [email])
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  slides StorySlide[]
  views  StoryView[]

  @@index([authorEmail, expiresAt])
  @@index([expiresAt])
}

model StorySlide {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  storyId   String @db.ObjectId
  story     Story  @relation(fields: [storyId], references: [id])
  imageUrl  String
  position  Int

  @@unique([storyId, position])
}

model StoryView {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  storyId     String   @db.ObjectId
  story       Story    @relation(fields: [storyId], references: [id])
  viewerEmail String
  viewedAt    DateTime @default(now())

  @@unique([storyId, viewerEmail])
  @@index([viewerEmail])
}

model PostLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  postId String @db.ObjectId
  post   Post   @relation(fields: [postId], references: [id])

  authorEmail String
  author      Profile @relation(fields: [authorEmail], references: [email])

  @@unique([postId, authorEmail])
}

model PostBookmark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  postId String @db.ObjectId
  post   Post   @relation(fields: [postId], references: [id])

  authorEmail String
  author      Profile @relation(fields: [authorEmail], references: [email])

  @@unique([postId, authorEmail])
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorEmail String
  author      Profile @relation(fields: [authorEmail], references: [email])

  postId String @db.ObjectId
  post   Post   @relation(fields: [postId], references: [id])

  parentCommentId String?   @db.ObjectId
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         Comment[] @relation("CommentReplies")

  likes CommentLike[]
  mentions CommentMention[]
}

model FollowRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  followerId String @db.ObjectId
  follower Profile @relation("FollowRequestsSent", fields: [followerId], references: [id])
  followingId String @db.ObjectId
  following Profile @relation("FollowRequestsReceived", fields: [followingId], references: [id])
  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model BookmarkCollection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId String   @db.ObjectId
  profile   Profile  @relation(fields: [profileId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items BookmarkCollectionPost[]

  @@unique([profileId, name])
  @@index([profileId, updatedAt])
}

model BookmarkCollectionPost {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  collectionId String             @db.ObjectId
  collection   BookmarkCollection @relation(fields: [collectionId], references: [id])
  postId       String             @db.ObjectId
  post         Post               @relation(fields: [postId], references: [id])
  createdAt    DateTime           @default(now())

  @@unique([collectionId, postId])
  @@index([postId])
}

model ProfileLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId String   @db.ObjectId
  profile   Profile  @relation(fields: [profileId], references: [id])
  label     String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([profileId, position])
}

model CommentMention {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  commentId String @db.ObjectId
  comment Comment @relation(fields: [commentId], references: [id])

  profileId String @db.ObjectId
  profile Profile @relation(fields: [profileId], references: [id])

  createdAt DateTime @default(now())

  @@unique([commentId, profileId])
  @@index([profileId, createdAt])
}

model CommentLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  commentId String  @db.ObjectId
  comment   Comment @relation(fields: [commentId], references: [id])

  authorEmail String
  author      Profile @relation(fields: [authorEmail], references: [email])

  @@unique([commentId, authorEmail])
}

model Report {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  reporterEmail String
  targetType    String
  targetId      String
  targetUrl     String?
  targetLabel   String?
  targetOwnerEmail String?
  reason        String
  status        String   @default("open")
  moderationAction String?
  moderationNote String?
  moderatedByEmail String?
  moderatedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model AdminNote {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  authorEmail String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments AdminNoteComment[]
  votes    AdminNoteVote[]
}

model AdminNoteComment {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  noteId    String    @db.ObjectId
  note      AdminNote @relation(fields: [noteId], references: [id])
  authorEmail String
  body      String
  createdAt DateTime  @default(now())

  @@index([noteId, createdAt])
}

model AdminNoteVote {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  noteId    String    @db.ObjectId
  note      AdminNote @relation(fields: [noteId], references: [id])
  voterEmail String
  createdAt DateTime  @default(now())

  @@unique([noteId, voterEmail])
}

model AdminActivity {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  actorEmail String
  kind String
  detail String
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// Topics / Hashtags
model Topic {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  posts     PostTopic[]
  followers TopicFollow[]
}

model PostTopic {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  postId String @db.ObjectId
  post   Post   @relation(fields: [postId], references: [id])

  topicId String @db.ObjectId
  topic   Topic  @relation(fields: [topicId], references: [id])

  @@unique([postId, topicId])
}

model TopicFollow {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  profileId String  @db.ObjectId
  profile   Profile @relation(fields: [profileId], references: [id])

  topicId String @db.ObjectId
  topic   Topic  @relation(fields: [topicId], references: [id])

  createdAt DateTime @default(now())

  @@unique([profileId, topicId])
}
