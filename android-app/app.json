{
  "expo": {
    "name": "Vibe",
    "slug": "vibe-android",
    "version": "0.5.0.5",
    "orientation": "portrait",
    "scheme": "vibebeta",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.vibe.social.beta",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ],
      "edgeToEdgeEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#111827"
      },
      "versionCode": 105
    },
    "extra": {
      "apiUrl": "https://vibe-social-network.vercel.app"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ]
  }
}
