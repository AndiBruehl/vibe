{
  "expo": {
    "name": "Vibe",
    "slug": "vibe-android",
    "version": "0.1.4",
    "orientation": "default",
    "scheme": "vibe",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.vibe.social",
      "adaptiveIcon": {
        "backgroundColor": "#111827"
      },
      "versionCode": 5
    },
    "extra": {
      "apiUrl": "https://vibe-social-network.vercel.app"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ]
  }
}
